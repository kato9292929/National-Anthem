# ナショナルアンセム — 環境変数の枠（M0）
# cp .env.example .env で作る。未設定の必須キーがあるとサーバは明示して停止する。

# --- M1 以降で必須 ---
# 市場シムのシード。同じ値なら同じ市場が再現する。
NA_MARKET_SEED=na-v0-0001

# --- 任意（未設定なら既定値） ---
# サーバの待受ポート（既定 8787）
NA_SERVER_PORT=8787
# world.config.json のパス上書き（未指定ならリポジトリ内の既定位置）
NA_WORLD_CONFIG=
# 1 で packages/client/dist を同一オリジンで配信する（スモーク検証用、既定 0）
NA_SERVE_CLIENT=0

# --- 区分B（実キー・実ネットワークが要る確認）---
# 揃った環境で npm run verify:b を回すと、通った段だけ証拠が記録される。
# 実 facilitator（PayAI）
NA_X402_FACILITATOR_URL=https://facilitator.payai.network
# 自分のエンドポイントを 402 でゲートする（1 で有効。実 facilitator が要る）
NA_X402_PAYWALL=0
# Solana の署名鍵（base58 の 64 byte keypair）。公式 SDK に渡す
NA_SOLANA_PRIVATE_KEY=
# Base の署名鍵（0x…）。Circle DCW を使うなら不要
NA_EVM_PRIVATE_KEY=

# --- testnet 実決済（Base Sepolia）: docs/testnet-base-sepolia-runbook.md ---
# 1 で物販デモを実 testnet（Base Sepolia）で settle する。mock ではなく実 tx が出る。
#   要: NA_X402_PAYWALL=1 / NA_X402_RAIL=base-sepolia / 実 facilitator / NA_EVM_PRIVATE_KEY
#   さらに config/x402.config.json の base-sepolia rail に payTo を入れて confirmed:true にする。
NA_X402_TESTNET=0
# 決済で使うレール id（既定 solana。testnet は base-sepolia）
NA_X402_RAIL=solana
# Base Sepolia の RPC（実 tx の receipt 確認に使う。egress allowlist に追加）
NA_BASE_SEPOLIA_RPC_URL=
# verify:b で実着金を確認する tx hash（実 settle で出た 0x…）
NA_VERIFY_BASE_SEPOLIA_TX=
# Circle DCW（EVM）で署名する場合
NA_CIRCLE_API_KEY=
NA_CIRCLE_EVM_WALLET_ID=
NA_CIRCLE_EVM_WALLET_ADDRESS=
# ERC-8004 レジストリ照会に使う Base の RPC
NA_BASE_RPC_URL=
# Arcium（実計算の呼び出し形は未実装）
NA_ARCIUM_CLUSTER_URL=
NA_ARCIUM_MXE_ID=
# Tripo の image→3D（公式 SDK tripo3d 経由）。platform.tripo3d.ai で発行
TRIPO_API_KEY=
# [M6 エージェント自律] 稼働前ゲートを満たすまで使わない
NA_LLM_API_KEY=
