# ナショナルアンセム — 環境変数の枠（M0）
# cp .env.example .env で作る。未設定の必須キーがあるとサーバは明示して停止する。

# --- M1 以降で必須 ---
# 市場シムのシード。同じ値なら同じ市場が再現する。
NA_MARKET_SEED=na-v0-0001

# --- 任意（未設定なら既定値） ---
# サーバの待受ポート（既定 8787）
NA_SERVER_PORT=8787
# world.config.json のパス上書き（未指定ならリポジトリ内の既定位置）
NA_WORLD_CONFIG=
# 1 で packages/client/dist を同一オリジンで配信する（スモーク検証用、既定 0）
NA_SERVE_CLIENT=0

# --- 後続マイルストーン用の枠（M0〜M2 では未使用・キー名は仮） ---
# 未設定のままで構わない。設定しても M0〜M2 では読まれない。
# [M3 identity/wallet]
NA_WALLET_PRIVATE_KEY=
# [M4 x402 決済]
NA_X402_FACILITATOR_URL=
# [M5 Arcium MXE]
NA_ARCIUM_CLUSTER_URL=
# [M6 エージェント自律] M0〜M2 では LLM を一切呼ばない
NA_LLM_API_KEY=
