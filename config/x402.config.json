{
  "$comment": "M4 x402 決済。確定値は加藤さん指定。未指定の値は TBD / confirmed:false のまま置き、使おうとしたら落とす。",
  "version": "0",
  "protocol": {
    "$comment": "稼働プロダクト（X-alpha / OSD / AA）の実装から取った実ワイヤ。scheme は exact。402 は PAYMENT-REQUIRED ヘッダ（base64）＋ body {}、top-level x402Version:2。支払いヘッダは PAYMENT-SIGNATURE、settle 応答は PAYMENT-RESPONSE。accepts は v1 leg（network \"solana\" / maxAmountRequired）と v2 leg（CAIP-2 / amount）を併記する。出どころは docs/x402-wire-contract.md。",
    "x402Version": 2,
    "scheme": "exact",
    "requirementsHeader": "PAYMENT-REQUIRED",
    "paymentHeader": "PAYMENT-SIGNATURE",
    "paymentResponseHeader": "PAYMENT-RESPONSE",
    "legAmountField": "amount",
    "confirmed": true,
    "legExpiryField": "expiresAt",
    "legExpiryConfirmed": false,
    "legAmountFieldV1": "maxAmountRequired",
    "supportedPath": "/supported",
    "verifyPath": "/verify",
    "settlePath": "/settle",
    "maxTimeoutSeconds": 300,
    "mimeType": "application/json"
  },
  "facilitator": {
    "url": "https://facilitator.payai.network",
    "provider": "PayAI",
    "confirmed": true,
    "verified": false
  },
  "feePayer": {
    "$comment": "feePayer は facilitator の /supported から毎回取る（PayAI はローテートする）。config には持たない。取得できないときは accepts を空にせず、feePayer 無しのまま返す。",
    "source": "response.accepts[].extra.feePayer",
    "hardcodedAllowed": false,
    "ttlMs": 300000
